# All keys are OPTIONAL. Evocast is bring-your-own-key: every visitor can
# paste their own keys in Settings (stored only in their browser).
# Set these only if you want your deployment to work without visitor keys.

# ElevenLabs (TTS, voice library, voice cloning)
ELEVENLABS_API_KEY=

# LLM — Anthropic (default provider)
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
LLM_MODEL=

# LLM — any OpenAI-compatible provider (DeepSeek, Qwen/DashScope, Kimi, GLM, OpenRouter...)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# If server keys are set, require visitors to enter this passcode before the
# server keys are used (prevents strangers from spending your credits).
APP_PASSCODE=

# ---------------------------------------------------------------------------
# Analytics + admin console (optional; leave empty and nothing is recorded)
# ---------------------------------------------------------------------------
# Any Postgres. On Vercel: Storage → Create → Neon → Connect (sets DATABASE_URL).
DATABASE_URL=
# Owner password for /admin (12+ characters).
ADMIN_PASSWORD=
# Serve the admin only on these hosts, e.g. admin.example.com,evocast-admin.vercel.app
ADMIN_HOST=
# Raw event retention in days (a daily cron purges older rows). Default 400.
ANALYTICS_RETENTION_DAYS=
# Vercel signs cron requests with this secret.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Free trial for visitors without keys (Vercel AI Gateway; needs DATABASE_URL)
# ---------------------------------------------------------------------------
# On Vercel the deployment's OIDC token is used automatically; elsewhere set a key.
# `npm run check:voices` uses it too (or VERCEL_OIDC_TOKEN from `vercel env pull`).
AI_GATEWAY_API_KEY=
# Daily caps in USD: per visitor (default 1.5) and for the whole site (default 5).
TRIAL_VISITOR_USD=
TRIAL_DAILY_USD=
# Set to "off" to show the offline demo instead.
TRIAL=
