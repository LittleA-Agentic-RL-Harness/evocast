# All keys are OPTIONAL. Evocast is bring-your-own-key: every visitor can
# paste their own keys in Settings (stored only in their browser).
# Set these only if you want your deployment to work without visitor keys.

# ElevenLabs (TTS, voice library, voice cloning)
ELEVENLABS_API_KEY=

# LLM — Anthropic (default provider)
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
LLM_MODEL=

# LLM — any OpenAI-compatible provider (DeepSeek, Qwen/DashScope, Kimi, GLM, OpenRouter...)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# If server keys are set, require visitors to enter this passcode before the
# server keys are used (prevents strangers from spending your credits).
APP_PASSCODE=
